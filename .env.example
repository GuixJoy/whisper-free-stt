# Floure backend environment — copy to .env and fill in:
#   cp .env.example .env

# Cloud LLM provider (only if you use cloud cleanup; local models need none)
OPENROUTER_API_KEY=

# Optional model override (default: openai/gpt-4o-mini)
# OPENROUTER_MODEL=

# Optional data dir override (default ~/.local/share/floure)
# STT_DATA_DIR=

# Optional compute override: cpu | vulkan (default: auto-detect)
# FLOURE_COMPUTE=
# Pinned GPU index for llama.cpp offload
# FLOURE_MAIN_GPU=
