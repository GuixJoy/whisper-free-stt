# Floure backend environment — copy to .env and fill in:
#   cp .env.example .env

# Cloud LLM providers (only the ones you use; local Gemma needs none)
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides (defaults: deepseek-chat / deepseek/deepseek-chat)
# DEEPSEEK_MODEL=
# OPENROUTER_MODEL=

# Optional data dir override (default ~/.local/share/floure)
# STT_DATA_DIR=

# Optional compute override: cpu | vulkan (default: auto-detect)
# FLOURE_COMPUTE=
# Pinned GPU index for llama.cpp offload
# FLOURE_MAIN_GPU=
