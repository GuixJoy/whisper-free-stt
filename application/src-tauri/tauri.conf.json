{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "floure",
  "version": "0.1.0",
  "identifier": "com.akshat.floure",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Floure",
        "width": 900,
        "height": 680,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "center": true,
        "decorations": false
      },
      {
        "label": "widget",
        "title": "",
        "url": "/index.html?window=widget",
        "width": 264,
        "height": 64,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    }
  },
    "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Local-first dictation: speech is transcribed on your machine and typed into the focused window.",
    "longDescription": "Floure listens to your mic, transcribes speech locally (Parakeet / Whisper via sherpa-onnx), cleans it up with a local or cloud LLM, and types the result into whatever window has focus. No account required for the local path.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional",
        "depends": [
          "librsvg2-2",
          "libssl3",
          "libasound2"
        ],
        "recommends": [
          "xdotool",
          "xclip",
          "wl-clipboard",
          "wtype"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libappindicator-gtk3",
          "librsvg2",
          "openssl",
          "alsa-lib"
        ],
        "recommends": [
          "xdotool",
          "xclip",
          "wl-clipboard",
          "wtype"
        ]
      }
    }
  },
  "plugins": {}
}
